package hooks

// Overlay-only synthetic integration fixture. Runs the pinned Crush source
// serializer, shell runner and output aggregation, never an agent or model.
import (
	"context"
	"encoding/json"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestGaneshToolHookAdapter(t *testing.T) {
	binary := os.Getenv("GANESH_TEST_BINARY")
	if binary == "" {
		t.Fatal("missing test binary")
	}
	spool := filepath.Join(t.TempDir(), "spool")
	quote := func(s string) string { return "'" + strings.ReplaceAll(s, "'", "'\\''") + "'" }
	command := quote(binary) + " hook crush --spool " + quote(spool)
	configs := map[string][]HookConfig{}
	for _, event := range []string{EventPreToolUse, EventPostToolUse, EventPostToolUseFailure, EventPermissionRequest, EventPermissionResult, EventTurnEnd, EventStopFailure, EventInterrupt} {
		configs[event] = []HookConfig{{Command: command, Timeout: 1}}
	}
	work := t.TempDir()
	runner := NewRunner(Static(configs), work, work)
	pre := Event{
		Name: EventPreToolUse, SessionID: "00000000-0000-4000-8000-000000000002",
		Tool: &ToolCall{ID: "call-1", Name: "write", Input: `{"file_path":"/synthetic/private","content":"ghp_SYNTHETIC_SECRET"}`},
	}
	check := func(ev Event) {
		t.Helper()
		a := runner.Run(context.Background(), ev)
		if a.HookCount != 1 || a.Decision != DecisionNone || a.Halt || a.Reason != "" || a.Context != "" || a.UpdatedInput != "" || a.UpdatedOutput != "" {
			t.Fatalf("adapter influenced client control/context: %+v", a)
		}
	}
	check(pre)
	check(pre) // Exact callback retry.
	post := pre
	post.Name, post.ToolResponse = EventPostToolUse, new("ghp_SYNTHETIC_SECRET")
	check(post)
	failure := pre
	failure.Name, failure.Error = EventPostToolUseFailure, "ghp_SYNTHETIC_SECRET"
	check(failure) // Conflicting result rejected, still no control decision.
	failure.Tool = &ToolCall{ID: "call-2", Name: "write", Input: pre.Tool.Input}
	check(failure)
	check(Event{Name: EventPreToolUse, SessionID: "invalid", Tool: pre.Tool})
	large := strings.Repeat("x", 128*1024) + "ghp_SYNTHETIC_SECRET"
	largeInput, err := json.Marshal(map[string]string{"content": large})
	if err != nil {
		t.Fatal(err)
	}
	largePre := pre
	largePre.Tool = &ToolCall{ID: "call-3", Name: "write", Input: string(largeInput)}
	check(largePre)
	largePost := largePre
	largePost.Name, largePost.ToolResponse = EventPostToolUse, &large
	check(largePost)
	check(largePost)
	largeFailure := failure
	largeFailure.Tool = &ToolCall{ID: "call-4", Name: "write", Input: pre.Tool.Input}
	largeFailure.Error = large
	check(largeFailure)
	request := pre
	request.Name = EventPermissionRequest
	check(request)
	check(request)
	for _, outcome := range []string{"granted", "denied", "cancelled"} {
		result := pre
		result.Name, result.Decision = EventPermissionResult, outcome
		check(result)
		check(result)
	}
	missing := pre
	missing.Name = EventPermissionResult
	check(missing)
	invalid := missing
	invalid.Decision = "allow"
	check(invalid)
	check(Event{Name: EventTurnEnd, SessionID: pre.SessionID})
	check(Event{Name: EventTurnEnd, SessionID: pre.SessionID, LastAssistantMessage: &large})
	check(Event{Name: EventStopFailure, SessionID: pre.SessionID})
	check(Event{Name: EventStopFailure, SessionID: pre.SessionID, Error: large})
	check(Event{Name: EventInterrupt, SessionID: pre.SessionID})
	check(Event{Name: EventInterrupt, SessionID: pre.SessionID})
	invalidTurn := pre
	invalidTurn.Name = EventInterrupt
	check(invalidTurn)
	check(Event{Name: EventStopFailure, SessionID: pre.SessionID, LastAssistantMessage: &large})
	entries, err := os.ReadDir(spool)
	if err != nil {
		t.Fatal(err)
	}
	count, failed, requests := 0, 0, 0
	permissionOutcomes := map[string]int{}
	turnOutcomes := map[string]int{}
	for _, entry := range entries {
		body, err := os.ReadFile(filepath.Join(spool, entry.Name()))
		if err != nil {
			t.Fatal(err)
		}
		for _, forbidden := range []string{"ghp_", "/synthetic", "call-", "tool_input", "tool_response", "last_assistant_message"} {
			if strings.Contains(string(body), forbidden) {
				t.Fatal("raw native content persisted")
			}
		}
		if !strings.HasSuffix(entry.Name(), ".json") {
			continue
		}
		count++
		var record struct {
			State, Origin, Coverage string
			Metadata                struct{ Event, Outcome string }
		}
		if json.Unmarshal(body, &record) != nil || record.State != "captured_local" || record.Origin != "unknown" || record.Coverage != "incomplete" {
			t.Fatal("native runner evidence gained authority")
		}
		if record.Metadata.Event == "tool_result" && record.Metadata.Outcome == "failed" {
			failed++
		}
		if record.Metadata.Event == "permission_request" {
			requests++
		}
		if record.Metadata.Event == "permission_result" {
			permissionOutcomes[record.Metadata.Outcome]++
		}
		if record.Metadata.Event == "turn_stop" {
			turnOutcomes[record.Metadata.Outcome]++
		}
	}
	if count != 13 || failed != 2 || requests != 1 || len(permissionOutcomes) != 3 || permissionOutcomes["granted"] != 1 || permissionOutcomes["denied"] != 1 || permissionOutcomes["cancelled"] != 1 {
		t.Fatalf("native runner effects: records=%d failed=%d", count, failed)
	}
	if len(turnOutcomes) != 3 || turnOutcomes["observed"] != 1 || turnOutcomes["failed"] != 1 || turnOutcomes["interrupted"] != 1 {
		t.Fatal("turn endings were lost, duplicated or promoted to success")
	}
}
