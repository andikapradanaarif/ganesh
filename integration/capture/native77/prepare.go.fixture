// One-off preparation for issue 77. It builds artifacts but launches no host.
package main

import (
	"bytes"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"go/format"
	"os"
	"path/filepath"
	"strings"
)

type binding77 struct {
	Path           string `json:"path"`
	SHA256         string `json:"sha256"`
	OriginalSHA256 string `json:"original_sha256,omitempty"`
}

func must77(err error) {
	if err != nil {
		panic("preparation failed")
	}
}
func digest77(b []byte) string { sum := sha256.Sum256(b); return hex.EncodeToString(sum[:]) }
func create77(name string, b []byte, mode os.FileMode) {
	f, e := os.OpenFile(name, os.O_WRONLY|os.O_CREATE|os.O_EXCL, mode)
	must77(e)
	_, e = f.Write(b)
	must77(e)
	must77(f.Close())
}

func main() {
	repo, e := os.Getwd()
	must77(e)
	root := filepath.Join(repo, ".local/s0/native-capture-77")
	create77(filepath.Join(root, "prepare.started"), []byte("77\n"), 0o600)
	var bindings []binding77
	for _, dir := range []string{"capture", "crush"} {
		source := "internal/capture"
		if dir == "crush" {
			source = "internal/adapter/crush"
		}
		dest := filepath.Join(root, "crush/internal/ganesh77", dir)
		must77(os.MkdirAll(dest, 0o700))
		entries, e := os.ReadDir(filepath.Join(root, "runtime", source))
		must77(e)
		for _, entry := range entries {
			if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") || strings.HasSuffix(entry.Name(), "_test.go") {
				continue
			}
			body, e := os.ReadFile(filepath.Join(root, "runtime", source, entry.Name()))
			must77(e)
			old := digest77(body)
			body = bytes.ReplaceAll(body, []byte("github.com/andikapradanaarif/ganesh/internal/capture"), []byte("github.com/charmbracelet/crush/internal/ganesh77/capture"))
			name := filepath.Join(dest, entry.Name())
			create77(name, body, 0o600)
			rel, e := filepath.Rel(root, name)
			must77(e)
			bindings = append(bindings, binding77{rel, digest77(body), old})
		}
	}
	for _, item := range [][2]string{{"host.go.fixture", "crush/internal/hooks/ganesh77_test.go"}, {"bridge.go.fixture", "crush/internal/ganesh77/capture/bridge77.go"}} {
		b, e := os.ReadFile(filepath.Join(repo, "integration/capture/native77", item[0]))
		must77(e)
		create77(filepath.Join(root, item[1]), b, 0o600)
		bindings = append(bindings, binding77{item[1], digest77(b), ""})
	}
	name := filepath.Join(root, "crush/internal/hooks/runner.go")
	b, e := os.ReadFile(name)
	must77(e)
	old := digest77(b)
	needle := []byte("type Runner struct {\n")
	if bytes.Count(b, needle) != 1 {
		panic("unexpected runner")
	}
	b = bytes.Replace(b, needle, []byte("type Runner struct {\n\tcapture77 func(context.Context, Event)\n"), 1)
	needle = []byte("\thooks := r.matchingHooks(ev)")
	if bytes.Count(b, needle) != 1 {
		panic("unexpected dispatch")
	}
	b = bytes.Replace(b, needle, []byte("\tif r.capture77 != nil { r.capture77(ctx, ev) }\n\thooks := r.matchingHooks(ev)"), 1)
	b, e = format.Source(b)
	must77(e)
	must77(os.WriteFile(name, b, 0o600))
	bindings = append(bindings, binding77{"crush/internal/hooks/runner.go", digest77(b), old})
	for _, name := range []string{"artifacts", "stores", "work"} {
		must77(os.Mkdir(filepath.Join(root, name), 0o700))
	}
	manifest, e := json.MarshalIndent(bindings, "", "  ")
	must77(e)
	create77(filepath.Join(root, "source-bindings.json"), append(manifest, '\n'), 0o600)
	fmt.Printf("copied/overlay source bindings: %d\n", len(bindings))
}
